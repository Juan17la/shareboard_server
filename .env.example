# Copy to `.env`. All values are optional; the defaults run a local memory-only server.

PORT=3000
HOST=0.0.0.0

# Comma-separated origins allowed to call REST/WS. "*" allows any.
CORS_ORIGIN=*

# Secret used to sign board tokens. Set a real one in production.
TOKEN_SECRET=dev-secret-change-me

# MongoDB connection. Leave empty to run in memory only (boards are lost on restart).
MONGO_URL=
MONGO_DB=shareboard
