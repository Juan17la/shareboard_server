# Copy to `.env`. MONGO_URL is required; everything else has a default.

PORT=3000
HOST=0.0.0.0

# Comma-separated origins allowed to call REST/WS. "*" allows any.
CORS_ORIGIN=*

# Secret used to sign board tokens. Set a real one in production.
TOKEN_SECRET=dev-secret-change-me

# MongoDB connection (local mongod or an Atlas mongodb+srv:// URL). Required.
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=shareboard

# Throwaway runs without a database: every board is lost on restart.
# MEMORY_ONLY=true

# Connections per server process, and how long a change may wait before it is
# written (edits inside the window share one write).
MONGO_POOL_SIZE=20
WRITE_DELAY_MS=1000
