{
  "name": "shareboard-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live Whiteboard backend \u2014 REST + WebSocket (see mobile/docs).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.1",
    "mongodb": "^6.20.0",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
